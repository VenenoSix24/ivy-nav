# SQLite 数据库文件路径
DATABASE_PATH=./data/portal.db

# 迁移文件目录
MIGRATIONS_PATH=./src/db/migrations

# 会话 Cookie 名
SESSION_COOKIE_NAME=ivy_session

# 会话 Cookie 是否只在 HTTPS 下回传。生产环境默认 true；
# 若自托管在内网只走明文 HTTP，设为 false 才能登录，但会话令牌将不再受传输层保护。
# SESSION_COOKIE_SECURE=false

# 登录失败次数上限与统计窗口。按用户名计数，并另有一道全局上限；
# 不按 IP 计数，因为 X-Forwarded-For 由客户端自己写，按它限流等于不限。
# LOGIN_ATTEMPT_LIMIT=10
# LOGIN_GLOBAL_ATTEMPT_LIMIT=30
# LOGIN_ATTEMPT_WINDOW_MS=900000

# 只有确实部署在可信反向代理之后才打开：打开后才会读取 X-Forwarded-For
# TRUST_PROXY_HEADERS=false

# 取站点图标时默认拒绝回环与 link-local 地址。若你的导航里有 localhost 或
# 链路本地地址的条目，并希望它们也显示图标，可以设为 true —— 代价是这台服务器
# 也能被指向内网地址的条目当作跳板。
# FAVICON_ALLOW_PRIVATE_HOSTS=false

# 站点对外地址，用于 OpenGraph 与绝对链接（生产环境建议设置）
# NEXT_PUBLIC_SITE_URL=https://portal.example.com
