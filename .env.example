# SQLite 数据库文件路径
DATABASE_PATH=./data/portal.db

# 迁移文件目录
MIGRATIONS_PATH=./src/db/migrations

# 会话 Cookie 名
SESSION_COOKIE_NAME=ivy_session

# 会话 Cookie 是否只在 HTTPS 下回传。生产环境默认 true；
# 若自托管在内网只走明文 HTTP，设为 false 才能登录，但会话令牌将不再受传输层保护。
# SESSION_COOKIE_SECURE=false

# 登录失败次数上限与统计窗口
# LOGIN_ATTEMPT_LIMIT=10
# LOGIN_ATTEMPT_WINDOW_MS=900000

# 站点对外地址，用于 OpenGraph 与绝对链接（生产环境建议设置）
# NEXT_PUBLIC_SITE_URL=https://portal.example.com
